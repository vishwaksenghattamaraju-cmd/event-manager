{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/inventory",
      "destination": "/inventory.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://event-inventory-app.onrender.com/api/$1"
    }
  ]
}
