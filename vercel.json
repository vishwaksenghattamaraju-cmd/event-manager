{
  "functions": {
    "api/index.py": {
      "includeFiles": "{frontend/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/inventory",
      "destination": "/inventory.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    }
  ]
}
