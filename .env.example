# Environment configuration
FLASK_ENV=development
FLASK_APP=backend.app:create_app
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database URL
# For local dev without MySQL setup:
DATABASE_URL=sqlite:///database/event_inventory.db

# For production / full MySQL concurrency tests:
# DATABASE_URL=mysql+pymysql://event_user:password123@localhost:3306/event_inventory_db

# Security & Session Settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False  # Set to True in production (HTTPS)
