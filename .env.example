# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env) - EVENT INVENTORY MANAGEMENT SYSTEM
# ==============================================================================
# Copy this file to .env for local development:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
#
# IMPORTANT: Never commit .env or database credentials to GitHub.
# ==============================================================================

# Application Environment (development | production)
FLASK_ENV=production
FLASK_APP=backend.app:create_app

# Secret Key for Session Signing & CSRF Protection
# Generate a new secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-64-character-hex-key

# Database Connection URL (PostgreSQL)
# ------------------------------------------------------------------------------
# 1. Local PostgreSQL development:
#    DATABASE_URL=postgresql://postgres:password@localhost:5432/event_inventory
#
# 2. Render Managed PostgreSQL (Production):
#    - For Render Web Service, copy the 'Internal Database URL' from your Render PostgreSQL dashboard:
#      DATABASE_URL=postgres://event_admin:PASSWORD@dpg-xxxxxx-a/event_inventory
#    (Note: The application automatically translates 'postgres://' to 'postgresql://')
#
# 3. External PostgreSQL Connection (for running local migration to Render):
#    - Copy the 'External Database URL' from your Render PostgreSQL dashboard:
#      DATABASE_URL=postgres://event_admin:PASSWORD@dpg-xxxxxx-a.oregon-postgres.render.com/event_inventory?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Connection Pool Settings (Defaults are tuned for Render & Gunicorn)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Session & Security Cookie Settings
# (Leave SECURE=True when deployed to Render HTTPS; set False for local HTTP)
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True

# Optional: Seed demo data on initial development spin-up (Defaults to False)
SEED_DEMO_USERS=False
SEED_DEMO_DATA=False
