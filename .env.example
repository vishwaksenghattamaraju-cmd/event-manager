# Environment configuration
FLASK_ENV=development
FLASK_APP=backend.app:create_app
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database URL
# 1. Local Development (SQLite):
DATABASE_URL=sqlite:///database/event_inventory.db

# 2. Vercel / Production Deployment (Persistent Hosted PostgreSQL - Recommended: Neon or Supabase):
# Note: Vercel serverless environments require a persistent cloud database so registered users
# and sessions persist across serverless container restarts and scale-downs.
# Examples:
# DATABASE_URL=postgresql://user:password@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres.projectref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Security & Session Settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True  # Set to True on production HTTPS (e.g. Vercel)
